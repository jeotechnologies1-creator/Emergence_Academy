# Local-only Supabase Edge Function configuration.
# Copy this file to .env for local development. Never commit the real .env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ollama Cloud settings for the ai-chat function. Keep the API key server-side.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=

# Required only by the applicable functions.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
